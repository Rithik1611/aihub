APP_NAME=aihub
DEBUG=false
# Exact origins. Also the CSRF allowlist: cookie-authenticated writes from any
# other Origin are refused (docs/adr/0007). No wildcards, no paths.
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Dev only, requires DEBUG=true: canned replies so chat works without the agent
AI_STUB=false

# The agent (ai/, in process - docs/adr/0006); all of these: ai/README.md
LUNA_BASE_URL=
LUNA_API_KEY=
LUNA_MODEL=gpt-5.6-luna
CC_API_URL=http://localhost:5000
CC_DB_URL=
CC_TERMINAL_URL=http://localhost:8070
OPEN_TERMINAL_API_KEY=

# aihub's own Postgres - NOT cableCORE's database (docs/adr/0004)
DATABASE_URL=postgresql+asyncpg://aihub:change-me@localhost:5432/aihub
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

# Must match cableCORE_BE's JWT_SECRET: aihub verifies the tokens cableCORE signs
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_COOKIE_NAME=access_token
JWT_LEEWAY_SECONDS=30

# Per-account chat limit; every chat request can call an LLM
CHAT_RATE_LIMIT=60
CHAT_RATE_WINDOW_SECONDS=60

# Pictures in the chat (empty = off): drawings link to the backend as the browser reaches it
CC_PUBLIC_URL=http://localhost:5000
SERPAPI_KEY=
IMAGE_MODEL=
IMAGE_PUBLIC_URL=http://localhost:8000

# MES as a guest app in DesignCenter chats (empty URL = off). Tokens per cableCORE username: {"username": "token"}
MES_MCP_URL=
MES_USER_TOKENS='{}'  # single quotes: a shell that sources this file keeps the JSON's double quotes
# MES_READ_TOOLS=mes_list_jobs,...   reviewed read tools besides those the server marks readOnlyHint (default: the 22 known)
