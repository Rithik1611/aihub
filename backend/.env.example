APP_NAME=aihub
DEBUG=false
# Exact origins. Also the CSRF allowlist: cookie-authenticated writes from any
# other Origin are refused (docs/adr/0007). No wildcards, no paths.
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# aihub AI service (under development)
AI_BASE_URL=http://localhost:8888/api/chatbot
# Dev only, requires DEBUG=true: canned replies so chat works without the AI service
AI_STUB=false

# aihub's own Postgres - NOT cableCORE's database (docs/adr/0004)
DATABASE_URL=postgresql+asyncpg://aihub:change-me@localhost:5432/aihub
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

# Must match cableCORE_BE's JWT_SECRET: aihub verifies the tokens cableCORE signs
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_COOKIE_NAME=access_token
JWT_LEEWAY_SECONDS=30

# Per-account chat limit; every chat request can call an LLM
CHAT_RATE_LIMIT=60
CHAT_RATE_WINDOW_SECONDS=60
