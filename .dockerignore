# Never ship secrets or local state in the image: the .env is read at run time (compose env_file), not baked in.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
.git
.gitignore
.vscode
.venv
.code_index
**/__pycache__
**/*.pyc
**/.mypy_cache
**/.pytest_cache
**/.ruff_cache
tests
**/tests
ai/apps/cablecore/evals
graphify-out
generated_images
compact2.json
